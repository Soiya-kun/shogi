{
  "name": "aether-shogi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:web": "playwright test",
    "build": "node scripts/validate-assets.mjs",
    "catalog": "node scripts/build-presentation-catalog.mjs",
    "cdk": "cdk",
    "infra:synth": "cdk synth --profile shogi-app",
    "infra:diff": "cdk diff --profile shogi-app",
    "deploy": "npm run build && cdk deploy --profile shogi-app --outputs-file cdk-outputs.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "aws-cdk": "2.1140.0",
    "aws-cdk-lib": "2.268.0",
    "constructs": "10.8.1",
    "three": "0.170.0"
  }
}
